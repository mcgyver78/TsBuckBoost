#!/bin/sh
#
# pre-commit: checks what is staged before it becomes a commit.
#
# Hooks are not part of a clone. Install once, as links, so that a change to
# these files is in effect at once:
#
#     ln -sf ../../tools/pre-commit .git/hooks/pre-commit
#     ln -sf ../../tools/pre-push .git/hooks/pre-push
#
# 1. tools/release-check, HEAD against the index: changelog history kept,
#    versions agree. See there for the rules and the override.
# 2. The tests in tests/, when a staged path is one they cover. They run on
#    the working tree, not on the index, so stage what you have tested.
#    TSBB_SKIP_TESTS=1 skips them.
#
# This only sees commits made in this clone. All three changelog truncations
# were committed in claude.ai/code sessions (Claude-Session trailer, +0000)
# and came in by pull; tools/pre-push catches such commits before they go on
# to the second remote.

cd "$(git rev-parse --show-toplevel)" || exit 1
git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0
[ -f tools/release-check ] || exit 0

sh tools/release-check HEAD --index || {
    echo "pre-commit: refusing this commit." >&2
    exit 1
}

[ "${TSBB_SKIP_TESTS:-}" = "1" ] && exit 0
[ -d tests ] || exit 0
git diff --cached --name-only | grep -Eq '^(dbus-tsbb\.py|tools/|tests/|extras/)' || exit 0

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, tests not run." >&2
    exit 0
fi

out=$(mktemp "${TMPDIR:-/tmp}/tsbb-tests.XXXXXX") || exit 1
# git hands GIT_INDEX_FILE (in a worktree GIT_DIR as well) to this hook. The
# tests build repositories of their own and must not inherit them.
if env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX \
        python3 -m unittest discover -s tests >"$out" 2>&1; then
    echo "pre-commit: $(grep '^Ran ' "$out"), $(tail -n 1 "$out")" >&2
    rm -f "$out"
    exit 0
fi
cat "$out" >&2
rm -f "$out"
echo "pre-commit: tests failed, refusing this commit (TSBB_SKIP_TESTS=1 to skip)." >&2
exit 1
