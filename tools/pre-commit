#!/bin/sh
#
# Refuse a commit that makes "changes" shorter than it already is.
#
# The changelog has been truncated twice by scripted edits that wrote the file
# instead of prepending to it: f797818 (v1.19) left 976 of 6660 bytes, c095815
# repaired it to 7636, and 958dfd0 (v1.20) cut it back to 723. Both times the
# whole release history was gone and nobody noticed until much later.
#
# A new entry always makes the file longer. If it gets shorter, something
# overwrote it. Set TSBB_ALLOW_CHANGELOG_SHRINK=1 for a deliberate shrink.

FILE=changes

git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0
git diff --cached --name-only | grep -qx "$FILE" || exit 0
git cat-file -e "HEAD:$FILE" 2>/dev/null || exit 0

old=$(git cat-file -s "HEAD:$FILE")

if git diff --cached --name-status -- "$FILE" | grep -q '^D'; then
    new=0
else
    blob=$(git ls-files --stage -- "$FILE" | awk '{print $2}')
    new=$(git cat-file -s "$blob")
fi

[ "$new" -ge "$old" ] && exit 0

if [ "$TSBB_ALLOW_CHANGELOG_SHRINK" = "1" ]; then
    echo "pre-commit: $FILE shrinks ${old} -> ${new} bytes, allowed on request." >&2
    exit 0
fi

cat >&2 <<MSG

pre-commit: refusing this commit.

  $FILE shrinks from ${old} to ${new} bytes.

A new changelog entry makes the file longer. Getting shorter means the file was
written over instead of prepended to - the bug behind f797818 and 958dfd0, which
lost the entire release history twice.

Check it:

    git diff --cached -- $FILE

The last intact copy of an earlier state can be recovered with:

    git show <commit>:$FILE

If the file really is meant to get shorter:

    TSBB_ALLOW_CHANGELOG_SHRINK=1 git commit ...

MSG
exit 1
