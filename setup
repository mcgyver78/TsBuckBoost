#!/bin/bash

# TsBuckBoost - Venus OS driver for the Victron Buck-Boost DC-DC converter
# (OEM: top systems TS 400 / TS 800 / TS 1600)
#
# The converter has no VE.Direct port. This driver reads its proprietary
# USB-serial protocol and registers it on D-Bus as com.victronenergy.alternator,
# so it shows up like an Orion XS on the GX display, in VRM and in Node-RED.
#
# Only read commands are ever sent to the converter.
#
# The driver lives in this package directory and is started by the service in
# services/TsBuckBoost - no Venus OS files are replaced.

# CommonResources prompts for install/uninstall, performs it and does not
# return here.
standardPromptAndActions='yes'

#### following line incorporates helper resources into this script
source "/data/SetupHelper/HelperResources/IncludeHelpers"
#### end of lines to include helper resources
